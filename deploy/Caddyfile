# Lumen — ergolumen.net
# HTTPS via Let's Encrypt
# UI → 127.0.0.1:3000 | Bridge WSS /ws/* → 127.0.0.1:3100

{
	email admin@ergolumen.net
	# TCP only — no HTTP/3 (QUIC)
	servers {
		protocols h1 h2
	}
}

# Force IPv4 listen (OpenVZ venet often needs explicit 0.0.0.0)
ergolumen.net, www.ergolumen.net {
	bind 0.0.0.0

	encode gzip

	handle_path /ws/* {
		reverse_proxy 127.0.0.1:3100
	}

	# /devnet/* removed (S1 security) — no devnet node on this host; was dead proxy to :9153

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Alt-Svc
		-Server
	}

	log {
		output file /var/log/caddy/ergolumen.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

http://80.209.232.82, http://toa.c.hostens.cloud {
	bind 0.0.0.0
	redir https://ergolumen.net{uri} permanent
}
