[Unit]
Description=Lumen Bridge Server (WebSocket hub + token/proxy API)
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lumen/bridge-server
Environment=NODE_ENV=production
# Bind localhost only — public access via Caddy wss://ergolumen.net/ws/*
Environment=HOST=127.0.0.1
Environment=PORT=3100
Environment=AUTO_REGISTER_TOKENS=0
EnvironmentFile=-/home/lumen/.env.local
ExecStart=/usr/bin/node /home/lumen/bridge-server/server.js
Restart=on-failure
RestartSec=3
Nice=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
